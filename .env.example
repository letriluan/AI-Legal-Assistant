# preview serves saved examples only; rag runs real retrieval/generation.
APP_MODE=preview
LEGAL_DATA_DIR=data/full
## Optional ARTIFACT_MANIFEST override; default is the bundled checksum manifest.
OLLAMA_HOST=http://127.0.0.1:11434
DEVICE=cpu
MODEL_LOCAL_FILES_ONLY=true
# Full mode requires matching BAAI/bge-m3 and BAAI/bge-reranker-v2-m3 checkpoints.
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
OLLAMA_TIMEOUT_SECONDS=120
